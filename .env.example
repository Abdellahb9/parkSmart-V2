# Settings for `docker compose` (copy to .env — never commit .env).

# Required. At least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Required by the seed task only. Choose your own; these are the demo
# accounts' passwords (admin, parking owners, technicians, drivers).
SEED_ADMIN_PASSWORD=
SEED_OWNER_PASSWORD=
SEED_TECH_PASSWORD=
SEED_USER_PASSWORD=

# Optional.
WEB_PORT=8080
# The address people type to reach the portal (used for the CORS allowlist).
PUBLIC_ORIGIN=http://localhost:8080
# 1 when the stack is served over HTTPS (marks the session cookie Secure).
REFRESH_COOKIE_SECURE=0
LOG_LEVEL=info
