# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/autopark

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
# Lifetime of the single token older clients receive (no X-Auth-Mode header).
JWT_EXPIRES_IN=7d

# ── Sessions (current web portal and mobile app) ─────────
# Short access token + rotating refresh token. See src/auth/tokens.js.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# Two tabs refreshing at once is not treated as a stolen token within this window.
REFRESH_REUSE_GRACE_MS=30000
# The web portal's refresh cookie. SameSite=none requires REFRESH_COOKIE_SECURE=1.
# Secure defaults to on when NODE_ENV=production.
REFRESH_COOKIE_SAMESITE=strict
REFRESH_COOKIE_SECURE=
REFRESH_COOKIE_PATH=/api/auth
REFRESH_RATE_LIMIT_MAX=30

# ── CORS ──────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API.
# Requests with no Origin header (mobile app, curl) are always allowed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Rate limiting on /api/auth/login and /api/auth/register ──
# Only FAILED attempts count toward the limit.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# ── Seed passwords (node seed.js) ─────────────────────────
# Local dev defaults are used when these are unset. Always set them
# for anything that is not your own machine.
SEED_ADMIN_PASSWORD=
SEED_OWNER_PASSWORD=
SEED_TECH_PASSWORD=
SEED_USER_PASSWORD=

# ── Logging & deployment ──────────────────────────────────
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Readable coloured logs in development (needs the pino-pretty dev dependency).
LOG_PRETTY=1
# Set to 1 behind ONE reverse proxy (nginx, a load balancer) so rate limits
# see the real client address.
TRUST_PROXY=
# Connection attempts at boot, 3 s apart, before giving up.
DB_CONNECT_ATTEMPTS=10

# ── Payments ──────────────────────────────────────────────
# Adapter in src/payments/. Only "mock" exists today: charges settle on
# POST /api/payments/:id/confirm, and { "outcome": "failure" } simulates a
# declined card. A CMI adapter will register under its own name.
PAYMENT_PROVIDER=mock

# ── Booking rules & availability job (all optional) ──────
# How far in the past a start time may be (a form filled a moment ago).
BOOKING_PAST_TOLERANCE_MINUTES=15
# How far ahead a booking may start.
BOOKING_MAX_ADVANCE_DAYS=30
# How early staff may validate an entry before the slot starts.
EARLY_CHECKIN_MINUTES=30
# An unchecked booking is expired (spot freed) this long after its end.
UNCHECKED_GRACE_MINUTES=120
# A checked-in car nobody checked out is closed this long after its end.
OVERSTAY_AUTOCLOSE_HOURS=12
# How long one booking request may hold a spot while it checks for overlaps.
SPOT_LOCK_MS=10000
# Set to 1 to run an extra API instance without its own background job.
DISABLE_AVAILABILITY_JOB=

# ── Tests (npm test) ──────────────────────────────────────
# The suite wipes this database; its name must end in _test.
MONGODB_URI_TEST=mongodb://localhost:27017/autopark_test
